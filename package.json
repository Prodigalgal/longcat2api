{
  "name": "longcat2api",
  "version": "1.0.0",
  "description": "LongCat 网页端 → OpenAI 兼容 API（chat/responses）· 临时邮箱注册 · CF 代理池 · 账号保活",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:init": "node -e \"import('./src/db/index.js').then(m => m.initDb())\"",
    "postinstall": "node scripts/postinstall-browsers.mjs",
    "browsers:fetch": "node scripts/postinstall-browsers.mjs",
    "register:one": "node -e \"import('./src/services/register.js').then(m=>m.runOneRegisterAttempt({}).then(r=>{console.log(JSON.stringify(r,null,2));process.exit(r.ok?0:1)}))\"",
    "register:headed": "node scripts/local-headed-register.mjs",
    "register:slider": "node scripts/local-slider-once.mjs",
    "register:captcha": "node scripts/local-captcha-once.mjs",
    "register:flow": "node scripts/local-full-flow.mjs",
    "captcha:health": "python scripts/local_captcha_solver.py health",
    "test:browser": "node scripts/local-browser-smoke.mjs",
    "test:keepalive": "node scripts/local-keepalive-once.mjs",
    "test:slider": "node --test src/services/sliderCaptcha.test.js",
    "test:lifecycle": "node --test src/services/keepalive.test.js src/services/longcatClient.test.js",
    "test:protocol": "node --test src/openai/openai.test.js",
    "test:session": "node --test src/services/accountCoordinator.test.js src/services/sessionStore.test.js src/openai/responseStore.test.js",
    "test": "npm run test:slider && npm run test:lifecycle && npm run test:protocol && npm run test:session"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "longcat",
    "openai",
    "proxy",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "camoufox-js": "^0.11.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "patchright": "^1.61.1",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^7.5.0",
    "uuid": "^11.1.0"
  }
}
